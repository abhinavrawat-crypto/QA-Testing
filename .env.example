# ==================================================
# AI-Assisted Requirements & Test Management Platform
# Environment Configuration Template
# Copy this file to .env and fill in your values
# ==================================================

# --- Database ---
POSTGRES_USER=aiqa
POSTGRES_PASSWORD=aiqa_secret_change_me
POSTGRES_DB=aiqa_platform

# --- Redis ---
REDIS_PASSWORD=redis_secret_change_me

# --- Backend ---
DATABASE_URL=postgresql+asyncpg://aiqa:aiqa_secret_change_me@postgres:5432/aiqa_platform
REDIS_URL=redis://:redis_secret_change_me@redis:6379/0

# --- Security ---
# Generate with: openssl rand -hex 32
SECRET_KEY=your_super_secret_key_here_change_me_in_production
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your_fernet_encryption_key_here

# JWT settings
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Google Gemini AI ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro
GEMINI_EMBEDDING_MODEL=text-embedding-004

# --- JIRA OAuth App (for OAuth 2.0 3LO) ---
JIRA_CLIENT_ID=your_jira_oauth_client_id
JIRA_CLIENT_SECRET=your_jira_oauth_client_secret
JIRA_REDIRECT_URI=http://localhost:8000/api/auth/jira/callback

# --- GitHub OAuth App ---
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_REDIRECT_URI=http://localhost:8000/api/auth/github/callback

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Docker (for Playwright sandbox) ---
# On Linux: unix:///var/run/docker.sock
# On Mac (Docker Desktop): unix:///var/run/docker.sock
DOCKER_HOST=unix:///var/run/docker.sock
PLAYWRIGHT_IMAGE=mcr.microsoft.com/playwright:v1.45.0-noble
SANDBOX_TIMEOUT_SECONDS=300
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_CPU_LIMIT=1.0

# --- Object Storage (for test artifacts) ---
# local = filesystem, minio = MinIO (local S3-compatible), gcs = Google Cloud Storage
STORAGE_BACKEND=local
ARTIFACTS_BASE_PATH=/tmp/aiqa_artifacts
# MinIO settings (if STORAGE_BACKEND=minio)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minio_access
MINIO_SECRET_KEY=minio_secret
MINIO_BUCKET=aiqa-artifacts

# --- Application ---
APP_NAME=AI QA Platform
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=info
